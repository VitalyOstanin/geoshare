rules_version = '2';

// What this database allows, and nothing besides.
//
// A deployment replaces the whole of a database's rules, so this file is the
// whole of what anybody may do here. Two things follow from that, and both are
// load-bearing.
//
// Nothing is granted that is not written below. A request no `match` reaches
// is refused, which means every collection outside `groups` is already shut —
// anything the owner of the project keeps by hand, anything a later
// application puts in the same database — and a subcollection under a group
// stays shut until a rule names it. There is deliberately no
// `match /{document=**}` here, not even one saying `if false`: allow rules are
// added together and none of them takes anything away, so a catch-all cannot
// forbid, and the only thing such a line could ever do is grant. The checks in
// "the rest of the database" hold this to account, so that a `match` written
// one level too far out fails a test rather than quietly handing over the rest
// of the project.
//
// And these rules bind one service and one database — `(default)`, the only
// one this project has. Storage and the Realtime Database are ruled
// separately, and this project has neither, so a mistake here has nothing else
// to reach.
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId} {
      function groupDocument() {
        return get(/databases/$(database)/documents/groups/$(groupId));
      }

      function groupMembers() {
        return groupDocument().data.members;
      }

      function isMember() {
        return request.auth != null && request.auth.uid in groupMembers();
      }

      // Who may change the roster. Read through the default because the
      // household that started before this existed has no such field, and its
      // roster is still the one edited from the console.
      function groupAdmins() {
        return groupDocument().data.get('admins', []);
      }

      function isGroupAdmin() {
        return request.auth != null && request.auth.uid in groupAdmins();
      }

      // How many people one group holds. Not a limit anybody is expected to
      // reach: it is what keeps a stolen code, or a mistake, from growing the
      // document without end, since a rule cannot walk a list to check it.
      function rosterFits() {
        return request.resource.data.members.size() <= 50;
      }

      // The group is made by the person who will run it, alone on the roster
      // and alone among its administrators. Nobody can conjure a group with
      // somebody else already in it.
      //
      // And it is named after them. A name of the founder's choosing would let
      // one account fill the database with groups nobody is in — a document
      // apiece, each of them free to make — while a name that is the account
      // itself gives everybody exactly one to make and one to lose. It is also
      // what the person invited is told: a code carries the name of the group
      // beside it, because a rule weighs a write to a path, and a path has to
      // be known before the write is made.
      function founding() {
        return request.auth != null &&
               groupId == request.auth.uid &&
               request.resource.data.keys().hasOnly(['members', 'admins']) &&
               request.resource.data.members == [request.auth.uid] &&
               request.resource.data.admins == [request.auth.uid];
      }

      // What the person invited does: add themselves, and nothing else.
      //
      // The caller is not on the roster yet, so nothing here may ask whether
      // they are a member. What stands in for that is the invitation: a
      // document whose name is the code, which only the rules ever read.
      function joining() {
        return request.auth != null &&
               !(request.auth.uid in resource.data.members) &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
               request.resource.data.members == resource.data.members.concat([request.auth.uid]) &&
               rosterFits() &&
               invitationStands();
      }

      // The code is handed over by the person invited in a document of their
      // own, because a rule cannot be told anything except through the
      // database: the write it weighs is the roster, and a code has nowhere to
      // ride in it.
      //
      // Nothing that is missing is read. A rule that reads a document that is
      // not there, or builds a path out of a field that is not there, refuses
      // the write through an evaluation error, and an error refuses the ones
      // that should have been allowed just as readily: the administrator
      // editing the roster is weighed against this same line.
      function claimedCode() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/joins/$(request.auth.uid))
                 ? get(/databases/$(database)/documents/groups/$(groupId)/joins/$(request.auth.uid))
                     .data.get('code', '')
                 : '';
      }

      function invitationStands() {
        return claimedCode() != '' &&
               exists(/databases/$(database)/documents/groups/$(groupId)/invitations/$(claimedCode())) &&
               get(/databases/$(database)/documents/groups/$(groupId)/invitations/$(claimedCode()))
                 .data.expiresAt > request.time;
      }

      // The person the group is named after, who made it. Nothing is hidden
      // from them that the roster could hide: whoever owns the project reads
      // the whole database from the console anyway, and the founder of the
      // household is that person. The other administrators own nothing, and
      // what they may do is narrower.
      //
      // The household that started before groups were named after anybody has
      // no founder by this test, and there every administrator is an ordinary
      // one.
      function isFounder() {
        return request.auth != null && request.auth.uid == groupId;
      }

      // Who left the roster in this write, and who left the administrators.
      function leftTheRoster() {
        return resource.data.members.toSet()
                 .difference(request.resource.data.members.toSet());
      }

      function leftTheAdmins() {
        return resource.data.get('admins', []).toSet()
                 .difference(request.resource.data.admins.toSet());
      }

      // What an administrator who is not the founder may not do. They take
      // off the roster only a member who runs nothing, so taking off another
      // administrator is two writes — the role first, the place second — and
      // neither can be done by accident in one tap. And the founder stays
      // where they are: on the roster and among the administrators.
      function withinAnAdministrator() {
        return !leftTheRoster().hasAny(resource.data.get('admins', [])) &&
               !leftTheRoster().hasAny([groupId]) &&
               !leftTheAdmins().hasAny([groupId]);
      }

      // What an administrator may do: take somebody off the roster, put
      // somebody on it, hand the running of the group to another member.
      //
      // The last administrator cannot resign into thin air — a group whose
      // roster nobody may change is one that goes back to the console — and
      // an administrator has to be on the roster, so that leaving the group
      // takes the power with it.
      function administering() {
        return isGroupAdmin() &&
               request.resource.data.keys().hasOnly(['members', 'admins']) &&
               rosterFits() &&
               request.resource.data.admins.size() >= 1 &&
               request.resource.data.admins.hasOnly(request.resource.data.members) &&
               (isFounder() || withinAnAdministrator());
      }

      allow read: if isMember();
      allow create: if founding();
      allow update: if joining() || administering();
      // A group is left by being taken off the roster. Deleting the document
      // would leave its members, profiles, grants and positions behind with
      // nothing to say who may read them.
      allow delete: if false;

      match /invitations/{code} {
        // Nobody reads these, including the people who made them: a reader
        // could collect the codes of a group and let themselves in. The rules
        // read them, and a rule reads without the caller's permission.
        //
        // The code is the name of the document rather than a field, so an
        // invitation cannot be found except by knowing it.
        function invitationShape() {
          return request.resource.data.keys().hasOnly(['createdBy', 'expiresAt']) &&
                 request.resource.data.createdBy == request.auth.uid &&
                 request.resource.data.expiresAt is timestamp;
        }

        allow read: if false;
        allow create: if isGroupAdmin() && invitationShape();
        // Withdrawing an invitation is deleting it; changing one in place
        // would let an expiry be pushed out for a code already handed round.
        allow update: if false;
        allow delete: if isGroupAdmin();
      }

      match /joins/{uid} {
        // The code somebody is holding, written where the rules can read it
        // while they weigh that person's own addition to the roster. It is
        // their document and nobody else's: reading it would be reading a
        // code, and writing it would be putting one into somebody's hand.
        //
        // The shape is held to what a code looks like because the rules build
        // a document path out of it. Letters and digits only, and eight of
        // them: a path cannot be escaped out of, and a typed code is not long.
        function claimShape() {
          return request.resource.data.keys().hasOnly(['code']) &&
                 request.resource.data.code is string &&
                 request.resource.data.code.matches('^[A-Z2-9]{8}$');
        }

        function isSelf() {
          return request.auth != null && request.auth.uid == uid;
        }

        allow read: if isSelf();
        allow create, update: if isSelf() && claimShape();
        allow delete: if isSelf();
      }

      match /falsePlaces/{placeId} {
        // Where a false signal is known to put the phones of this group.
        //
        // In the database rather than in the build, because which places those
        // are is a fact about one household's surroundings: a build carrying
        // them hands them to everybody who downloads it, and a list of places
        // where receivers are being lied to says as much about the
        // neighbourhood as about the phones.
        //
        // Everybody in the group reads it, including somebody who joined an
        // hour ago on a code: a phone that does not know the places takes the
        // lie as its anchor, which is the one failure this list exists to
        // prevent. Only an administrator writes it, for the same reason they
        // are the ones who edit the roster — a place added wrongly is ground
        // the group's phones can no longer be placed on.
        //
        // The coordinates are held to the globe and the radius to fifty
        // kilometres; what those numbers mean is weighed again on the phone,
        // since a rule can hold the shape of a document and not its sense.
        function falsePlaceShape() {
          return request.resource.data.keys()
                   .hasOnly(['latitude', 'longitude', 'radiusMetres', 'named']) &&
                 request.resource.data.latitude is number &&
                 request.resource.data.latitude >= -90 &&
                 request.resource.data.latitude <= 90 &&
                 request.resource.data.longitude is number &&
                 request.resource.data.longitude >= -180 &&
                 request.resource.data.longitude <= 180 &&
                 request.resource.data.radiusMetres is number &&
                 request.resource.data.radiusMetres > 0 &&
                 request.resource.data.radiusMetres <= 50000 &&
                 (!('named' in request.resource.data) ||
                  (request.resource.data.named is string &&
                   request.resource.data.named.size() <= 100));
        }

        allow read: if isMember();
        allow create, update: if isGroupAdmin() && falsePlaceShape();
        // Stated apart from the write: a deletion carries no document whose
        // shape could be checked.
        allow delete: if isGroupAdmin();
      }

      match /settings/{key} {
        // What the group has settled about how its phones judge an answer.
        //
        // Today one document: what counts as going round in circles, which is
        // the shape of the transmitter over this neighbourhood rather than
        // anything about the application. Held here so that narrowing the
        // rule does not mean publishing the numbers in a build.
        //
        // Everybody in the group reads it, because every phone weighs its own
        // answers against it; only an administrator writes it, because limits
        // set wrongly either catch nothing or refuse honest positions.
        //
        // The shape is held to numbers of the right kind and nothing else.
        // What those numbers mean together — that the widest is wider than
        // the tightest, that a run is long enough to disagree with a circle —
        // is weighed on the phone, which is where such a judgement belongs.
        function settingNumbers() {
          return request.resource.data.keys().hasOnly(['answers', 'withinSeconds',
                   'roundness', 'widestMetres', 'tightestMetres', 'steadiness',
                   'turnedDegrees', 'slowestMps']) &&
                 (!('answers' in request.resource.data) ||
                  (request.resource.data.answers is int &&
                   request.resource.data.answers >= 4 &&
                   request.resource.data.answers <= 200)) &&
                 (!('withinSeconds' in request.resource.data) ||
                  (request.resource.data.withinSeconds is number &&
                   request.resource.data.withinSeconds > 0)) &&
                 (!('roundness' in request.resource.data) ||
                  (request.resource.data.roundness is number &&
                   request.resource.data.roundness > 0)) &&
                 (!('widestMetres' in request.resource.data) ||
                  (request.resource.data.widestMetres is number &&
                   request.resource.data.widestMetres > 0)) &&
                 (!('tightestMetres' in request.resource.data) ||
                  (request.resource.data.tightestMetres is number &&
                   request.resource.data.tightestMetres > 0)) &&
                 (!('steadiness' in request.resource.data) ||
                  (request.resource.data.steadiness is number &&
                   request.resource.data.steadiness > 0)) &&
                 (!('turnedDegrees' in request.resource.data) ||
                  (request.resource.data.turnedDegrees is number &&
                   request.resource.data.turnedDegrees > 0)) &&
                 (!('slowestMps' in request.resource.data) ||
                  (request.resource.data.slowestMps is number &&
                   request.resource.data.slowestMps >= 0));
        }

        allow read: if isMember();
        allow create, update: if isGroupAdmin() && key == 'circling' && settingNumbers();
        allow delete: if isGroupAdmin();
      }

      match /members/{uid} {
        // What a member says about themselves: the name and the picture their
        // account carries, so that a marker can name a person rather than the
        // first characters of an account id. Membership itself is the array in
        // the group document, which stays out of every client's reach, so
        // writing one's own profile grants nothing.
        //
        // Nothing else lives here, because everyone in the group reads this
        // document: which phones a member carries, and whom they let watch,
        // are in the grant below, where only the people concerned can see
        // them.
        function profileShape() {
          return request.resource.data.keys()
                   .hasOnly(['displayName', 'photoUrl', 'updatedAt']) &&
                 request.resource.data.displayName is string &&
                 request.resource.data.displayName.size() <= 100 &&
                 (!('photoUrl' in request.resource.data) ||
                  request.resource.data.photoUrl == null ||
                  (request.resource.data.photoUrl is string &&
                   request.resource.data.photoUrl.size() <= 500));
        }

        function isOwner() {
          return isMember() && request.auth.uid == uid;
        }

        allow read: if isMember();
        // Stated apart from the delete: a deletion carries no document to
        // check the shape of, and a single write rule would refuse every one.
        allow create, update: if isOwner() && profileShape();
        allow delete: if isOwner();
      }

      match /grants/{uid} {
        // Whom this member lets watch, and which phones they carry. Both are
        // answers to "where is this person", so both are kept away from the
        // members who were not given one: being in the household tells you
        // that somebody is in it, not how many phones they own or who else
        // they share with.
        //
        // The phones have moved to `devices` above, where an administrator
        // can see them without seeing whom they are shared with. The field
        // stays allowed here while phones of an older build still write it,
        // and readers fall back on it for a member none of whose phones has
        // written the new document yet.
        //
        // The sizes are there because a reader acts on this document: one
        // subscription per device named here, so a list of thousands would put
        // every screen that may read it out of action. Rules cannot walk a
        // list, so the count is what can be held; the clients cut the list to
        // the same number before they subscribe.
        function grantShape() {
          return request.resource.data.keys().hasOnly(['devices', 'sharedWith']) &&
                 (!('sharedWith' in request.resource.data) ||
                  (request.resource.data.sharedWith is map &&
                   request.resource.data.sharedWith.size() <= 50)) &&
                 (!('devices' in request.resource.data) ||
                  (request.resource.data.devices is list &&
                   request.resource.data.devices.size() <= 10));
        }

        function isOwner() {
          return isMember() && request.auth.uid == uid;
        }

        // The permission is in the document being read, so weighing it costs
        // nothing: a reader who has been given one sees the phones to
        // subscribe to, and the same withdrawal that stops the positions stops
        // this as well.
        function mayReadGrant() {
          return resource != null &&
                 resource.data.get('sharedWith', {}).get(request.auth.uid, null) != null &&
                 resource.data.sharedWith[request.auth.uid] > request.time;
        }

        // One document at a time: listing the collection would hand every
        // member the whole household's phones, which is the leak this
        // collection exists to close.
        allow get: if isMember() && (isOwner() || mayReadGrant());
        allow create, update: if isOwner() && grantShape();
        allow delete: if isOwner();
      }

      match /devices/{uid} {
        // The phones this member carries, one entry per phone under its id:
        // the model, the name its owner gave it, and when it was last in touch
        // with the mode and the charge it had then. No place: an administrator
        // reads this to tell a phone that went quiet from one whose marker is
        // stuck, and neither needs to know where the phone is.
        //
        // Kept apart from the grant so that an administrator can be shown the
        // phones without being shown whom their owner shares with.
        //
        // The rules hold the number of phones and not the fields of each: a
        // rule cannot walk a map, and the readers weigh every entry as they
        // take it, dropping what is not a phone.
        function devicesShape() {
          return request.resource.data.size() <= 10;
        }

        function isOwner() {
          return isMember() && request.auth.uid == uid;
        }

        // The same permission that opens the positions: a reader who may watch
        // the member learns which phones there are to watch.
        function mayWatch() {
          return exists(/databases/$(database)/documents/groups/$(groupId)/grants/$(uid)) &&
                 get(/databases/$(database)/documents/groups/$(groupId)/grants/$(uid))
                   .data.get('sharedWith', {}).get(request.auth.uid, null) != null &&
                 get(/databases/$(database)/documents/groups/$(groupId)/grants/$(uid))
                   .data.sharedWith[request.auth.uid] > request.time;
        }

        // One document at a time, as with the grants: a listing would hand a
        // member the phones of everybody they were not given.
        allow get: if isMember() && (isOwner() || isGroupAdmin() || mayWatch());
        allow create, update: if isOwner() && devicesShape();
        allow delete: if isOwner();
      }

      match /labels/{uid} {
        // What a member calls the phones and the people of the group, for
        // themselves alone: "new phone" rather than a model number, "grandma"
        // rather than the name on her account. Nobody else reads it, the
        // person named included.
        //
        // A phone is named by its full address, account and phone joined by a
        // dot, so that two phones of one model are two names.
        function labelsShape() {
          return request.resource.data.keys().hasOnly(['devices', 'members']) &&
                 (!('devices' in request.resource.data) ||
                  (request.resource.data.devices is map &&
                   request.resource.data.devices.size() <= 500)) &&
                 (!('members' in request.resource.data) ||
                  (request.resource.data.members is map &&
                   request.resource.data.members.size() <= 50));
        }

        function isSelf() {
          return isMember() && request.auth.uid == uid;
        }

        allow get: if isSelf();
        allow create, update: if isSelf() && labelsShape();
        allow delete: if isSelf();
      }

      match /positions/{positionId} {
        // One document per phone rather than per member: a member with two
        // phones had them overwriting each other's position, and which of the
        // two the marker showed depended on which wrote last.
        //
        // The id is the account and the phone joined by a dot, so a member
        // reaches only their own documents whatever their phones are called.
        // The owner is repeated inside the document, because that is what the
        // readers group the markers by.
        function ownsPosition() {
          return isMember() && positionId.split('\\.')[0] == request.auth.uid;
        }

        // Being in the group is not the same as being allowed to watch: the
        // owner names their readers one by one, and each permission carries
        // the moment it runs out.
        //
        // The permission is read from the owner's grant, which is where they
        // write it, and not from a copy inside this document. A copy would be
        // cheaper — a rule that reads another document pays for a read — but a
        // copy only changes when the phone writes its next position, so
        // withdrawing it would take effect at the phone's convenience: ten
        // minutes for a phone standing still, an hour and a half at night, and
        // never at all for a phone that is switched off, lost or no longer has
        // the application. A permission has to stop when it is withdrawn.
        //
        // Read through the defaults rather than by indexing: an owner without
        // a grant of their own, or a reader without a permission in it, has to
        // come out as a plain refusal and not as an error.
        function grant() {
          return get(/databases/$(database)/documents/groups/$(groupId)/grants/$(positionId.split('\\.')[0]));
        }

        function permission() {
          return grant() == null ? null
                                 : grant().data.get('sharedWith', {}).get(request.auth.uid, null);
        }

        function mayRead() {
          return permission() != null && permission() > request.time;
        }

        // What a position is allowed to be. Without this a member — or an
        // account somebody else has got hold of — could put fields of any name
        // and size into their own documents, up to the megabyte a document
        // holds, and every other client would fetch them.
        //
        // The coordinates are held to the globe: the clients drop a position
        // outside it, and the rule is what keeps it from being written at all.
        function positionShape() {
          return request.resource.data.keys()
                   .hasOnly(['memberId', 'deviceName', 'latitude', 'longitude',
                             'takenAt', 'writtenAt', 'mode', 'batteryPercent', 'charging',
                             'accuracyMetres', 'foundBy', 'settling',
                             'leftOutCount', 'leftOutReason', 'leftOutSince']) &&
                 request.resource.data.memberId == request.auth.uid &&
                 request.resource.data.latitude is number &&
                 request.resource.data.latitude >= -90 &&
                 request.resource.data.latitude <= 90 &&
                 request.resource.data.longitude is number &&
                 request.resource.data.longitude >= -180 &&
                 request.resource.data.longitude <= 180 &&
                 request.resource.data.takenAt is timestamp &&
                 // The moment the server stamped, which is the one clock the
                 // readers can trust: a phone cannot claim a position is newer
                 // than it is.
                 (!('writtenAt' in request.resource.data) ||
                  request.resource.data.writtenAt == request.time) &&
                 (!('deviceName' in request.resource.data) ||
                  (request.resource.data.deviceName is string &&
                   request.resource.data.deviceName.size() <= 40)) &&
                 (!('mode' in request.resource.data) ||
                  (request.resource.data.mode is string &&
                   request.resource.data.mode.size() <= 20)) &&
                 (!('batteryPercent' in request.resource.data) ||
                  (request.resource.data.batteryPercent is int &&
                   request.resource.data.batteryPercent >= 0 &&
                   request.resource.data.batteryPercent <= 100)) &&
                 (!('charging' in request.resource.data) ||
                  request.resource.data.charging is bool) &&
                 // How wide the provider said its answer is, which the readers
                 // draw as a circle. Held to a hundred kilometres: past that a
                 // circle stops describing a place, and a number of any size
                 // would let one phone paint over the whole map.
                 (!('accuracyMetres' in request.resource.data) ||
                  (request.resource.data.accuracyMetres is number &&
                   request.resource.data.accuracyMetres >= 0 &&
                   request.resource.data.accuracyMetres <= 100000)) &&
                 // How the phone says it arrived at the answer: one of the
                 // words the clients know, and a word from a build newer than
                 // a reader is shown as it came. Held to the length of a word
                 // for the same reason as the mode — a reader shows it, and a
                 // field of any size would be a sentence of somebody's
                 // choosing on everybody's card.
                 (!('foundBy' in request.resource.data) ||
                  (request.resource.data.foundBy is string &&
                   request.resource.data.foundBy.size() <= 20)) &&
                 // Whether the receiver had not settled since the phone was
                 // switched on. A flag rather than the count of satellites or
                 // the seconds since the boot: the readers show a sentence,
                 // and what the limits of that window are is the phone's
                 // business and changes between builds.
                 (!('settling' in request.resource.data) ||
                  request.resource.data.settling is bool);
        }

        // One document at a time, and no listing of the collection. A query is
        // allowed only when its own filters prove the rule, and an expiry
        // compared against the server's clock cannot be proved by anything a
        // client sends. So a reader walks the roster instead: the grant of a
        // member names their devices, and each of those is a document read by
        // name.
        // What a phone says while its answers are being thrown away, and it is
        // therefore writing no positions at all. Without it a phone under a
        // transmitter is indistinguishable from a phone in a drawer: both stop
        // writing, and the marker of each quietly gets older.
        //
        // The count is held to a number a run of answers can reach — seven
        // seconds apart, a day of them is twelve thousand — and the reason to
        // a length a word and a switch fit in, for the same reason the mode
        // and the source are held to one: a reader shows it. A source the
        // member switched off arrives as two words joined by a colon, because
        // which of the five it was is what the card is opened for.
        function leftOutShape() {
          return (!('leftOutCount' in request.resource.data) ||
                  (request.resource.data.leftOutCount is int &&
                   request.resource.data.leftOutCount >= 0 &&
                   request.resource.data.leftOutCount <= 100000)) &&
                 (!('leftOutReason' in request.resource.data) ||
                  (request.resource.data.leftOutReason is string &&
                   request.resource.data.leftOutReason.size() <= 40)) &&
                 (!('leftOutSince' in request.resource.data) ||
                  request.resource.data.leftOutSince is timestamp);
        }

        // Those three fields and nothing else, on a document already there.
        //
        // Stated as a way of its own rather than folded into the shape above,
        // because such a write leaves the position where it is — coordinates,
        // the moment they were taken and the moment the server stamped all
        // stay as they were. The whole-document shape cannot allow that: it
        // holds `writtenAt` to the server's clock of this very request, so a
        // phone saying this much through it would have to renew the moment of
        // a position it did not take. A marker whose `writtenAt` moved on
        // while the phone wrote nothing would stop ageing under a
        // transmitter, and the age of a marker is what a reader decides by.
        //
        // An owner writing their own document whole is a different matter and
        // stays allowed: what this branch removes is the need to.
        function onlyTheLeftOutChanged() {
          return resource != null &&
                 request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['leftOutCount', 'leftOutReason', 'leftOutSince']);
        }

        allow get: if isMember() && (ownsPosition() || mayRead());
        allow create, update: if ownsPosition() &&
                                 ((positionShape() && leftOutShape()) ||
                                  (onlyTheLeftOutChanged() && leftOutShape()));
        // Stated apart from the write: a deletion carries no document whose
        // owner could be checked.
        allow delete: if ownsPosition();
      }

      match /watch/{watchId} {
        // Also per phone: a member looking at the map on one phone should not
        // clear the marker their other phone had just written, and a phone
        // ignores only its own marker rather than every marker of its account.
        function ownsWatch() {
          return isMember() && watchId.split('\\.')[0] == request.auth.uid;
        }

        // The claim says when it was made, by the clock of the server, and the
        // phones add the three minutes themselves. Written the other way round
        // — an expiry chosen by the viewer — it would be worth whatever that
        // viewer's clock says: a clock running slow would never start the fast
        // mode at all, and a claim dated years ahead would hold every phone of
        // the group in it for good.
        function watchShape() {
          return request.resource.data.keys().hasOnly(['memberId', 'since']) &&
                 request.resource.data.memberId == request.auth.uid &&
                 request.resource.data.since == request.time;
        }

        allow read: if isMember();
        allow create, update: if ownsWatch() && watchShape();
        allow delete: if ownsWatch();
      }
    }
  }
}
