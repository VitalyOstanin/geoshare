<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: a published build keeps the platform's own answer, which is
     that nothing goes over plain HTTP. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug only as well (ADR-0044): signs a stand-in account in on a
             command from the shell. DUMP is held by the shell and by no
             installed application, so nothing on the device can send it. -->
        <receiver
            android:name=".service.StandInSignInReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.vitalyostanin.geoshare.debug.STAND_IN_SIGN_IN" />
                <action android:name="io.github.vitalyostanin.geoshare.debug.STAND_IN_SIGN_OUT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
