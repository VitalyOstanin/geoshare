<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The map library asks whether there is a connection before it goes
         looking for a tile it has no copy of. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The position itself. The background one is asked for separately, and
         is what lets the service start after a restart rather than only while
         a screen of ours is up. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Lets the phone say when its owner started walking or riding, which is
         what the Moving mode is made of. Counted by a chip that is awake
         anyway, so it costs nothing like a fix does; refusing it leaves every
         other mode working. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Lets the settings screen tell the receiver to throw away the orbits
         and the last place it searches by. Granted without asking, since the
         command changes nothing outside this phone's own receiver. -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lights the screen while the siren sounds, so the button that stops it
         is on the locked screen without anybody pressing power first. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Asked for in a dialog of the system's own: a phone that stops the
         service while nobody is looking at the screen stops answering the
         other members, whose fast collecting arrives over a subscription. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The manufacturers' own startup lists, which are what the phone reads
         rather than the setting above. Named here because a package that is
         not asked for cannot be seen at all from Android 11 onwards, and the
         settings row has to know whether this phone has such a screen. -->
    <queries>
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.vivo.permissionmanager" />
    </queries>

    <application
        android:name=".GeoshareApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locale_config"
        android:theme="@style/Theme.Geoshare">

        <!-- Started by the Firebase libraries themselves at process start,
             before anything of ours has run, and off a google-services.json
             this build no longer carries: one build serves every family, so
             it is FamilyProject.start rather than this that decides which
             project's credentials Firebase begins with. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            tools:node="remove" />

        <!-- Where the language a member picks inside the application is kept on
             a phone that has nowhere of its own to keep it: per-application
             languages are a setting of the system only from Android 13, and
             AndroidX stores the answer itself below that. The service is a
             place to hang the flag on rather than something to run, which is
             why it is declared disabled. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SharingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
