    <string name="visibility_until">until %1$s</string>
    <!-- The name of the way a phone was collecting when it wrote the position.
         A name rather than a sentence describing it: what each one asks for and
         how often it sends belongs in the help the card opens, where all five
         can be read against each other. The document carries the entry of the
         enumeration, which is the key of the lookup rather than anything shown,
         so a translation names the modes in its own language. The page says the
         same. -->
    <string name="mode_idle">Idle</string>
    <string name="mode_standby">Standby</string>
    <string name="mode_moving">Moving</string>
    <string name="mode_viewing">Viewing</string>
    <string name="mode_night">Night</string>

    <!-- Who else has the map open right now: %1$s is the members, listed by
         name and separated by commas. Named rather than counted, and stated
         once for the whole household rather than on a card, because one open
         map puts every phone of the group into the same way of collecting. -->
    <string name="map_watching">Map open: %1$s</string>

    <string name="map_more">More</string>
    <string name="map_more_hide">Hide</string>

    <plurals name="map_group_count">
        <item quantity="one">%1$d member</item>
        <item quantity="other">%1$d members</item>
    </plurals>

    <!-- Members whose position this phone is not allowed to read, or cannot
         reach: without this the map simply has fewer markers on it, and a
         refusal looks exactly like a member who is not sharing. -->
    <plurals name="map_out_of_reach">
        <item quantity="one">%1$d member is not sharing with you right now.</item>
        <item quantity="other">%1$d members are not sharing with you right now.</item>
    </plurals>

    <plurals name="map_more_count">
        <item quantity="one">%1$d member</item>
        <item quantity="other">%1$d members</item>
    </plurals>

    <!-- The same ages in the narrow cards of the panel, where a card holds a
         face, a name and the age on one line. No plural forms: the unit is an
         abbreviation, which does not decline. -->
    <string name="map_age_short_now">now</string>
    <string name="map_age_short_minutes">%1$d min</string>
    <string name="map_age_short_hours">%1$d h</string>
    <string name="map_age_short_days">%1$d d</string>

    <plurals name="map_age_minutes">
        <item quantity="one">%1$d minute ago</item>
        <item quantity="other">%1$d minutes ago</item>
    </plurals>
    <plurals name="map_age_hours">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
    </plurals>
    <plurals name="map_age_days">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>
