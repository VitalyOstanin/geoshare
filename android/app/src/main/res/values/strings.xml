    <!-- The language of the application, which a phone before Android 13 has
         nowhere else to set. The two named languages say so in their own
         words: a member looking for theirs reads it before anything else. -->
    <string name="language_title">Language</string>
    <string name="language_russian">Русский</string>
    <string name="language_english">English</string>
    <string name="language_system">System</string>
    <string name="group_title">Who is in the group</string>
    <string name="group_none">You are not in a group yet. Make one and hand out a code, or enter the code somebody sent you.</string>
    <string name="group_found">Make a group</string>
    <string name="group_code_label">Invitation code</string>
    <string name="group_join">Join</string>
    <string name="group_invite">Make a code</string>
    <string name="group_invite_again">Make another code</string>
    <string name="group_code_lasts">The code lets somebody in for a day, and lets in everybody it reaches in that time.</string>
    <string name="group_runs_it">runs the group</string>
    <string name="group_remove">Remove</string>
    <string name="group_unrun">Nobody runs this group, so its members are set from the Firebase console.</string>
    <string name="visibility_title">Who sees where I am</string>
    <string name="visibility_empty">Nobody else has signed in yet.</string>
    <string name="visibility_none">not shared</string>
    <string name="visibility_hour">for an hour</string>
    <string name="visibility_eight_hours">for eight hours</string>
    <string name="visibility_day">for a day</string>
    <string name="visibility_forever">with no end</string>
    <!-- A permission given earlier, counting down: %1$s is a time of day. -->
    <string name="visibility_until">until %1$s</string>
    <!-- The name of the way a phone was collecting when it wrote the position.
         A name rather than a sentence describing it: what each one asks for and
         how often it sends belongs in the help the card opens, where all five
         can be read against each other. The document carries the entry of the
         enumeration, which is the key of the lookup rather than anything shown,
         so a translation names the modes in its own language. The page says the
         same. -->
    <string name="mode_idle">Idle</string>
    <string name="mode_standby">Standby</string>
    <string name="mode_moving">Moving</string>
    <string name="mode_viewing">Viewing</string>
    <string name="mode_night">Night</string>

    <!-- The help the mode on a card opens. All five are described in one place
         rather than a sentence at a time on the cards: what a mode means is
         only clear against the other four, and a member reads it once. The page
         says the same. -->
    <string name="mode_help_title">How a phone collects its position</string>
    <string name="mode_help_intro">The phone chooses one of these five by itself. Somebody with the map open outranks everything else; the rest of the time it spends as little as it can and still be found.</string>
    <string name="mode_help_when">When</string>
    <string name="mode_help_asks">What the phone does</string>
    <string name="mode_help_when_viewing">Somebody has the map open.</string>
    <string name="mode_help_asks_viewing">Asks for the most exact position every 15 seconds, and writes it as soon as the marker would move.</string>
    <string name="mode_help_when_moving">The phone noticed walking, running, cycling or riding.</string>
    <string name="mode_help_asks_moving">Asks every 5 minutes.</string>
    <string name="mode_help_when_standby">Away from where it last wrote, with nobody looking.</string>
    <string name="mode_help_asks_standby">Asks every 15 minutes.</string>
    <string name="mode_help_when_night">Between 23:00 and 07:00, or the charge is below 15 per cent.</string>
    <string name="mode_help_asks_night">Asks every 20 minutes, in the cheapest way it has.</string>
    <string name="mode_help_when_idle">Settled within 150 metres of the position it last wrote.</string>
    <string name="mode_help_asks_idle">Asks for nothing at all, and repeats the last position every 25 minutes so the card does not go grey.</string>

    <!-- Who else has the map open right now: %1$s is the members, listed by
         name and separated by commas. Named rather than counted, and stated
         once for the whole household rather than on a card, because one open
         map puts every phone of the group into the same way of collecting. -->
    <string name="map_watching">Map open: %1$s</string>

    <string name="map_more">More</string>
    <string name="map_more_hide">Hide</string>

    <plurals name="map_group_count">
        <item quantity="one">%1$d member</item>
        <item quantity="other">%1$d members</item>
    </plurals>

    <!-- Members whose position this phone is not allowed to read, or cannot
         reach: without this the map simply has fewer markers on it, and a
         refusal looks exactly like a member who is not sharing. -->
    <plurals name="map_out_of_reach">
        <item quantity="one">%1$d member is not sharing with you right now.</item>
        <item quantity="other">%1$d members are not sharing with you right now.</item>
    </plurals>

    <plurals name="map_more_count">
        <item quantity="one">%1$d member</item>
        <item quantity="other">%1$d members</item>
    </plurals>

    <!-- The same ages in the narrow cards of the panel, where a card holds a
         face, a name and the age on one line. No plural forms: the unit is an
         abbreviation, which does not decline. -->
    <string name="map_age_short_now">now</string>
    <string name="map_age_short_minutes">%1$d min</string>
    <string name="map_age_short_hours">%1$d h</string>
    <string name="map_age_short_days">%1$d d</string>

    <plurals name="map_age_minutes">
        <item quantity="one">%1$d minute ago</item>
        <item quantity="other">%1$d minutes ago</item>
    </plurals>
    <plurals name="map_age_hours">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
    </plurals>
    <plurals name="map_age_days">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>
</resources>
