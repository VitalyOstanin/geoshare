<resources>
    <!-- The name of the application, which is the same in every language. -->
    <string name="app_name" translatable="false">Geoshare</string>

    <string name="sign_in_explanation">Sign in with the Google account the family shares positions under.</string>
    <string name="sign_in_action">Sign in with Google</string>
    <string name="sign_in_running">Signing in…</string>
    <string name="sign_in_failed_no_account">No Google account on this phone. Add one in the system settings, then sign in again.</string>
    <string name="sign_in_failed_offline">No connection. Sign-in needs the network for a moment.</string>
    <string name="sign_in_failed_misconfigured">This build cannot sign in on this phone: its Google services do not accept it.</string>
    <string name="sign_in_failed_unknown">Sign-in did not go through. Try again.</string>

    <string name="sign_out_action">Sign out</string>

    <string name="sharing_action">Share my position</string>
    <string name="sharing_channel_name">Position sharing</string>
    <string name="sharing_channel_description">Shown while your position is being shared with the family.</string>
    <string name="sharing_notification_title">Sharing your position</string>
    <string name="sharing_notification_text">The family can see where you are.</string>
    <string name="sharing_notification_stop">Stop</string>

    <!-- The filter that leaves out positions the phone cannot have reached.
         Off unless asked for: it throws answers away, and only somebody whose
         satellites are being jammed wants that. -->
    <string name="jumps_title">Leave out impossible positions</string>
    <string name="jumps_explained">Where the satellites are jammed, the phone is told it is somewhere it cannot be, and the marker jumps across the map. This leaves out any position that would have taken more than 200 km/h to reach.</string>
    <string name="jumps_forget">Forget the last place</string>
    <string name="jumps_forgotten">Forgotten</string>

    <string name="permission_location_needed">Sharing needs access to this phone\'s position. Allow it in the application settings.</string>
    <string name="permission_notifications_needed">Allow notifications, so that a running service can say so.</string>
    <string name="permission_background_needed">To keep sharing while the application is closed, set the location access to \"Allow all the time\" in the application settings.</string>
    <string name="permission_open_settings">Open the settings</string>
    <string name="map_nobody_yet">Nobody has shared a position yet.</string>
    <string name="map_member_you">You</string>
