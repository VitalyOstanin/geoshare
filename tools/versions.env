# The pinned toolchain versions, written down once.
#
# Read by the scripts in this directory and by android/app/build.gradle.kts;
# the Containerfile takes them as build arguments rather than repeating them.
# Shell syntax on purpose: `source` here, a two-line parser in Gradle.
#
# A version that appears in exactly one place is not here: minSdk and
# targetSdk live in android/app/build.gradle.kts, the library versions in
# android/gradle/libs.versions.toml.

ANDROID_COMPILE_SDK=37
ANDROID_PLATFORM=android-37.0
ANDROID_BUILD_TOOLS=37.0.0

# The system image the headless emulator runs.
ANDROID_EMULATOR_API=36

# The command-line tools the SDK image installs everything else with. Pinned
# against the SHA-1 Google publishes in repository2-1.xml
# (040d3996a65543d22ec4bf73e4c37aa37a8d4af4).
CMDLINE_TOOLS_RELEASE=15859902
CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583

# What Gradle and the Kotlin compiler run on. The newest long-term release;
# Gradle runs on it from 9.1.0 onwards.
JDK_VERSION=25

# Only used to generate the wrapper the first time; the build itself runs the
# wrapper the project commits. The digest is the one Gradle publishes beside
# the archive, and the same value stands in gradle-wrapper.properties.
GRADLE_VERSION=9.8.1
GRADLE_SHA256=dce76f55f8e251a3a1f130eb120f30b3d271de2b76c9b0729d316b5a1b6dc01f

# The Node runtime the rules tests run on, and the Firebase command line that
# carries the Firestore emulator they run against.
NODE_VERSION=24
FIREBASE_TOOLS_VERSION=15.33.0
# The emulator is a Java program, and firebase-tools refuses anything older.
FIREBASE_JRE_VERSION=21

# The linter of the JavaScript half. Fetched by npx when the check runs rather
# than installed into the tree: there is no build step for the page, and a
# node_modules beside it would be the only one in the repository.
ESLINT_VERSION=10.12.0

# The linter of the documents, fetched by npx for the same reason.
MARKDOWNLINT_CLI2_VERSION=0.23.3

# The checker of the shell scripts, run from its own image.
SHELLCHECK_VERSION=0.11.0

# The browser the landing page's pictures of the setup page are taken in,
# run from its own image.
PLAYWRIGHT_VERSION=1.64.1
