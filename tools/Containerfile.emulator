# Headless emulator for trying the application without a phone.
#
# Split from the SDK image on purpose: the system image alone is well over a
# gigabyte, and an ordinary build has no use for it.
#
# Built by tools/run-emulator.sh, which builds the base image first and passes
# both arguments from tools/versions.env.
ARG SDK_IMAGE
FROM ${SDK_IMAGE}

ARG ANDROID_EMULATOR_API
ARG ANDROID_EMULATOR_VARIANT=google_apis
ENV API_IMAGE=system-images;android-${ANDROID_EMULATOR_API};${ANDROID_EMULATOR_VARIANT};x86_64

# The emulator binary links against X11 and friends even when told not to open
# a window: -no-window suppresses the window, not the dependency.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libx11-6 libxcb1 libxdamage1 libxext6 libxfixes3 libxrender1 \
        libnss3 libpulse0 libgl1 libglu1-mesa libdrm2 libgbm1 \
    && rm -rf /var/lib/apt/lists/*

# google_apis unless told otherwise: it is what most phones carry. The plain
# image, default, stands for the phones sold without Play services, where the
# position comes from the platform's own providers.
RUN sdkmanager --install "emulator" "${API_IMAGE}" \
    && rm -rf "${ANDROID_HOME}/.temp"

ENV PATH="${ANDROID_HOME}/emulator:${PATH}"
ENV ANDROID_AVD_HOME=/avd

# Baked into the image rather than created at run time: the device never
# varies, and creating it on every run costs a minute of nothing.
RUN mkdir -p /avd \
    && echo no | avdmanager create avd -n phone -k "${API_IMAGE}" -d pixel_6 \
    && chmod -R 777 /avd

# Rendering on the host GPU: the Mesa drivers, and weston with Xwayland for the
# X display -gpu host insists on even without a window (emulator-entrypoint.sh
# explains why). Without a render node passed in, none of this is used.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libegl1 libegl-mesa0 libgles2 libgl1-mesa-dri libglx-mesa0 \
        mesa-vulkan-drivers libvulkan1 weston xwayland \
    && rm -rf /var/lib/apt/lists/*

COPY emulator-entrypoint.sh /usr/local/bin/emulator-entrypoint

# The renderer is chosen at start: the GPU when a render node is usable,
# swiftshader_indirect on the CPU otherwise.
CMD ["emulator-entrypoint"]
